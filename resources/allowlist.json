{
  "$comment": [
    "The single allowlist shared by the browser (resources/js/core/sanitize.ts) and",
    "the server (src/HtmlSanitizer.php). Change it here only; both sides read it.",
    "allow: kept, with the listed attributes. unwrap: the element is removed but its",
    "content kept. drop: removed together with its content. Any element in none of",
    "the three (non-standard or custom tags) is dropped with its content, matching",
    "symfony/html-sanitizer. tests/Arch checks every standard element is classified."
  ],
  "allow": {
    "p": [],
    "br": [],
    "h2": [],
    "h3": [],
    "h4": [],
    "strong": [],
    "b": [],
    "em": [],
    "i": [],
    "s": [],
    "del": [],
    "u": [],
    "code": [],
    "pre": [],
    "blockquote": [],
    "ul": [],
    "ol": [],
    "li": [],
    "hr": [],
    "a": [
      "href",
      "target"
    ],
    "img": [
      "src",
      "alt",
      "width"
    ],
    "table": [],
    "thead": [],
    "tbody": [],
    "tr": [],
    "th": [
      "colspan",
      "rowspan"
    ],
    "td": [
      "colspan",
      "rowspan"
    ]
  },
  "unwrap": [
    "abbr",
    "acronym",
    "address",
    "article",
    "aside",
    "basefont",
    "bdi",
    "bdo",
    "big",
    "body",
    "caption",
    "center",
    "cite",
    "col",
    "colgroup",
    "data",
    "dd",
    "details",
    "dfn",
    "dir",
    "div",
    "dl",
    "dt",
    "fieldset",
    "figcaption",
    "figure",
    "font",
    "footer",
    "h1",
    "h5",
    "h6",
    "header",
    "hgroup",
    "html",
    "ins",
    "kbd",
    "label",
    "layer",
    "legend",
    "main",
    "map",
    "mark",
    "marquee",
    "menu",
    "meter",
    "nav",
    "nobr",
    "output",
    "picture",
    "popup",
    "progress",
    "q",
    "rb",
    "rp",
    "rt",
    "rtc",
    "ruby",
    "samp",
    "section",
    "slot",
    "small",
    "span",
    "strike",
    "sub",
    "summary",
    "sup",
    "tfoot",
    "time",
    "tt",
    "var",
    "wbr"
  ],
  "drop": [
    "applet",
    "area",
    "audio",
    "base",
    "bgsound",
    "button",
    "canvas",
    "command",
    "datalist",
    "dialog",
    "embed",
    "form",
    "frame",
    "frameset",
    "head",
    "iframe",
    "image",
    "input",
    "keygen",
    "link",
    "listing",
    "math",
    "meta",
    "noscript",
    "object",
    "optgroup",
    "option",
    "plaintext",
    "portal",
    "script",
    "select",
    "selectmenu",
    "source",
    "style",
    "svg",
    "template",
    "textarea",
    "title",
    "track",
    "video",
    "xmp"
  ],
  "attributePatterns": {
    "a": {
      "target": "^_blank$"
    },
    "img": {
      "width": "^(?:[1-9][0-9]{0,3}|(?:100|[1-9][0-9]?)%)$"
    },
    "th": {
      "colspan": "^[1-9][0-9]?$",
      "rowspan": "^[1-9][0-9]?$"
    },
    "td": {
      "colspan": "^[1-9][0-9]?$",
      "rowspan": "^[1-9][0-9]?$"
    }
  },
  "forcedAttributes": {
    "a": {
      "rel": "noopener noreferrer"
    }
  },
  "linkSchemes": [
    "http",
    "https",
    "mailto",
    "tel"
  ],
  "mediaSchemes": [
    "http",
    "https"
  ],
  "dataImageTypes": [
    "png",
    "jpeg",
    "gif",
    "webp",
    "avif"
  ]
}
