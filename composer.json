{
    "name": "2bo-velocity/ohashirichtexteditor",
    "description": "Encapsulated, dependency-free rich text editor built with Web Components and Shadow DOM. First-class Laravel integration (Blade, Livewire, Inertia); the editor and its HTML sanitiser also work in plain PHP.",
    "keywords": [
        "laravel",
        "php",
        "wysiwyg",
        "rich-text-editor",
        "web-components",
        "shadow-dom",
        "inertia",
        "livewire",
        "html-sanitizer"
    ],
    "homepage": "https://ohashirichtexteditor.com",
    "license": "AGPL-3.0-or-later",
    "type": "library",
    "authors": [
        {
            "name": "2bo-velocity",
            "homepage": "https://github.com/2bo-velocity"
        }
    ],
    "support": {
        "issues": "https://github.com/2bo-velocity/ohashirichtexteditor/issues",
        "docs": "https://ohashirichtexteditor.com"
    },
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-libxml": "*",
        "symfony/html-sanitizer": "^8.0"
    },
    "require-dev": {
        "livewire/livewire": "^3.8.3|^4.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0"
    },
    "suggest": {
        "ext-gd": "Required for image uploads: images are checked and re-encoded with GD (PNG, JPEG, GIF, WebP).",
        "laravel/framework": "For the Blade component, service provider and upload route (Laravel 12 or 13).",
        "livewire/livewire": "wire:model on <x-ohashi-editor> (Livewire 3.8.3+ or 4)."
    },
    "conflict": {
        "laravel/framework": "<12.0",
        "illuminate/support": "<12.0"
    },
    "autoload": {
        "psr-4": {
            "OhashiEditor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OhashiEditor\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OhashiEditor\\Laravel\\OhashiEditorServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
