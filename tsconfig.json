{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    // The adapters import the core by its package name, so that in a consumer's
    // app they share the one installed copy. Here, point that name at the source.
    "paths": {
      "@2bo-velocity/ohashirichtexteditor": ["./resources/js/index.ts"]
    }
  },
  "include": ["resources/js", "tests/js", "tests/browser/*.ts", "vite.config.ts", "playwright.config.ts"]
}
